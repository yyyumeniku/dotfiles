{
  "layer": "top",
  "position": "top",
  "height": 25,
  "spacing": 12,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "custom/cpu", "custom/memory", "custom/pulseaudio", "clock#date"],
  "tray": {
    "spacing": 10,
    "icon-size": 14
  },
  "hyprland/workspaces": {
    "format": "{name}",
    "persistent-workspaces": {
      "*": [1, 2, 3, 4]
    }
  },
  "custom/cpu": {
    "exec": "~/.config/waybar/stats cpu",
    "interval": 2,
    "return-type": "json"
  },
  "custom/memory": {
    "exec": "~/.config/waybar/stats memory",
    "interval": 1,
    "return-type": "json"
  },
  "custom/pulseaudio": {
    "exec": "~/.config/waybar/stats volume-loop",
    "return-type": "json"
  },
  "clock#date": {
    "format": "{:%Y-%m-%d}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}"
  }
}
