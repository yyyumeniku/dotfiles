{
  "layer": "top",
  "position": "top",
  "height": 22,
  "spacing": 12,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "cpu", "memory", "pulseaudio", "clock#date"],
  "tray": {
    "spacing": 10,
    "icon-size": 14,
  },
  "hyprland/workspaces": {
    "format": "{name}",
    "persistent-workspaces": {
      "*": [1, 2, 3, 4]
    }
  },
  "cpu": {
    "interval": 5,
    "format": "\uf2db  {usage}%"
  },
  "memory": {
    "interval": 2,
    "format": "\uefc5  {used:0.1f}G",
    "tooltip-format": "\uefc5 {used:0.1f}G / {total:0.1f}G ({percentage}%)"
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "\uf026  {volume}%",
    "format-icons": {
      "default": ["\uf026", "\uf027", "\uf028"]
    }
  },
  "clock#date": {
    "format": "{:%Y-%m-%d}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}"
  }
}
