{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 6,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "cpu", "memory", "pulseaudio", "clock#date"],
  "tray": {
    "spacing": 10
  },
  "hyprland/workspaces": {
    "format": "{name}",
    "persistent-workspaces": {
      "*": [1, 2, 3, 4]
    }
  },
  "cpu": {
    "interval": 5,
    "format": "CPU {usage}%"
  },
  "memory": {
    "interval": 2,
    "format": "RAM {used:0.1f}G",
    "tooltip-format": "RAM {used:0.1f}G / {total:0.1f}G ({percentage}%)"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "MUTED",
    "format-icons": {
      "default": ["VOL"]
    }
  },
  "clock#date": {
    "format": "{:%Y-%m-%d}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}"
  }
}
